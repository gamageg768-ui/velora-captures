# Database (SQLite for local/dev). For production, swap to PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/obscura"
DATABASE_URL="file:./dev.db"

# Email (Resend — https://resend.com). Create a free account to get an API key.
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM="OBSCURA Studio <hello@obscura.studio>"
STUDIO_EMAIL="hello@obscura.studio"

# Admin dashboard — choose a long random string as your password.
ADMIN_SECRET="change-this-to-a-long-random-secret"
